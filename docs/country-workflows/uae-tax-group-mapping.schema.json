{
  "$defs": {
    "FrameworkAdjustment": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "member": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Member",
          "type": "string"
        },
        "line_reference": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Line Reference",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]{1,28}(?:\\.[0-9]{1,8})?$"
            }
          ],
          "title": "Delta",
          "description": "Use an exact bounded plain decimal string (at most28 total digits and8 decimal places). Fractional JSON numbers are rejected. Cross-field and total-digit checks run during preparation."
        },
        "category": {
          "enum": [
            "uniform_policy",
            "uae_ct_exclusion",
            "consolidation_acquisition_removal",
            "intramember_elimination",
            "consequential_asset_adjustment"
          ],
          "title": "Category",
          "type": "string"
        },
        "counterparty_member": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterparty Member"
        },
        "transaction_reference": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transaction Reference"
        },
        "source_reference": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Source Reference",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "member",
        "line_reference",
        "delta",
        "category",
        "source_reference",
        "rationale"
      ],
      "title": "FrameworkAdjustment",
      "type": "object"
    },
    "MemberStatements": {

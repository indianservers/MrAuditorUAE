        "accounting_standard": {
          "enum": [
            "IFRS",
            "IFRS_FOR_SMES",
            "unassessed"
          ],
          "title": "Accounting Standard",
          "type": "string"
        },
        "uniform_policy": {
          "enum": [
            "assessed_aligned",
            "adjusted_with_evidence",
            "unassessed"
          ],
          "title": "Uniform Policy",
          "type": "string"
        },
        "policy_assessment": {
          "maxLength": 4000,
          "minLength": 10,
          "title": "Policy Assessment",
          "type": "string"
        },
        "source_evidence_version_id": {
          "format": "uuid",
          "title": "Source Evidence Version Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/StatementLine"
          },
          "maxItems": 20000,
          "minItems": 4,
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "member",
        "legal_entity_id",
        "role",
        "period_start",
        "period_end",
        "membership_from",
        "membership_through",
        "currency",
        "basis",
        "accounting_standard",
        "uniform_policy",
        "policy_assessment",
        "source_evidence_version_id",
        "source_sha256",
        "lines"
      ],
      "title": "MemberStatements",
      "type": "object"
    },

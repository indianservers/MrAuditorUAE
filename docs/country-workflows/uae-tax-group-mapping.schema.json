          "maxItems": 2,
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "deductible_loss": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,28}(?:\\.[0-9]{1,8})?$"
            }
          ],
          "title": "Deductible Loss",
          "description": "Use an exact bounded plain decimal string (at most28 total digits and8 decimal places). Fractional JSON numbers are rejected. Cross-field and total-digit checks run during preparation."
        },
        "previously_reversed": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{1,28}(?:\\.[0-9]{1,8})?$"
            }
          ],
          "title": "Previously Reversed",
          "description": "Use an exact bounded plain decimal string (at most28 total digits and8 decimal places). Fractional JSON numbers are rejected. Cross-field and total-digit checks run during preparation."
        },
        "period_income": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "integer"

# Copy to .env, generate independent secrets with scripts/generate_secrets.py.
ENVIRONMENT=development
JWT_SECRET=replace-with-generated-signing-secret-at-least-48-characters
BOOTSTRAP_SECRET=replace-with-generated-one-time-setup-secret
POSTGRES_PASSWORD=replace-with-generated-database-password
POSTGRES_ADMIN_PASSWORD=replace-with-independent-admin-password
DATABASE_URL=postgresql+asyncpg://auditos:replace-with-generated-database-password@localhost:5432/auditos
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
CORS_ORIGINS=[]
# Secrets are injected server-side, never stored in database or returned to clients.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=512
AI_TIMEOUT_SECONDS=20

# Phase 2: local storage is development-only; production requires private versioned S3.
SOURCE_STORAGE_PATH=../.private-source-objects
SOURCE_S3_BUCKET=
SOURCE_S3_REGION=me-central-1
SOURCE_KMS_KEY=
# Independent Fernet key; setup_env.py generates it. Back up and rotate with re-encryption.
CONNECTOR_ENCRYPTION_KEY=replace-with-generated-connector-key
ZOHO_REDIRECT_URIS=["http://localhost:8000/oauth/zoho"]
FINANCIAL_AI_HOURLY_REQUESTS=20

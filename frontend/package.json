    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "@xyflow/react": "^12.12.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
